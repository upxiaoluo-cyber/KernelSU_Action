#内核源码地址
KERNEL_SOURCE=https://github.com/upxiaoluo-cyber/DBY-W09huawei4.0
#内核源码分支（留空，自己填）
KERNEL_SOURCE_BRANCH=main
#内核编译配置（留空，自己填，例如 arch/arm64/configs/ 下的 defconfig 文件名）
KERNEL_CONFIG=merge_kona_defconfig
#内核Image.gz-dtb or Image
KERNEL_IMAGE_NAME=Image
ARCH=arm64

#参数
# 华为 4.19 非 GKI：不要用 LLVM=1 / LLVM_IAS=1 / ld.lld
EXTRA_CMDS:LD=aarch64-linux-gnu-ld
EXTRA_CMDT:LLVM=0
EXTRA_CMDU:LLVM_IAS=0
EXTRA_CMDV:CROSS_COMPILE=aarch64-linux-gnu-
EXTRA_CMDW:TARGET_BUILD_VARIANT=user
EXTRA_CMDX:KCFLAGS=-Wno-strict-prototypes

########################################################################################################################################################
# 编译方案'A'clang+gcc编译 'B'clang编译
METHOD_OK=A

# 编译器选择'true'将使用自定义编译器Clang  'false'将使用编译器AOSP
# 华为 4.19 建议用 AOSP clang-r383902，也就是 clang 11，别用 r445002/clang12
USE_CUSTOM_CLANG=false

# python切换默认python3(ture将切换到python2)
CUT_PYTHON=false

# 自定义编译器Clang
## Custom
CUSTOM_CLANG_SOURCE=https://github.com/AOSP-12/prebuilts_clang_host_linux-x86_clang-r445002.git
CUSTOM_CLANG_BRANCH=12

###如果您设置使用自定义clang为false，则不要更改自定义CMDS 
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

## 编译器AOSP
分支main     android-gs-bluejay-5.10-android13      android-msm-bonito-4.9-android12-qpr1  android-msm-coral-4.14-android13  
3289846       3289846                                3289846                                 3289846
r450784e      r416183b                               r383902                                 r383902
r475365b      r450784d                               r399163b                                r399163b
r487747c      r450784e                               r416183b                                r416183b
r498229
#分支
CLANG_BRANCH=android-msm-coral-4.14-android13
#版本
CLANG_VERSION=r383902


########################################################################################################################################################

# 开启 LXC and DOCKER
LXC_DOCKER=false

# 是否打入LXC补丁
LXC_PATCH=false

# 关闭CONFIG_ANDROID_PARANOID_NETWORK配置防止docker and lxc出现网络问题
ANDROID_PARANOID_NETWORK_OFF=false

#######################################################################################################################################################

# KernelSU / SukiSU 选择
# 你只要 SUK，所以关掉 KernelSU，打开 SukiSU
ENABLE_KERNELSU=false
KERNELSU_TAG=v0.9.5

# SukiSU-Ultra
ENABLE_SUKISU=true
SUKISU_REPO=https://github.com/SukiSU-Ultra/SukiSU-Ultra.git
# 建议用 release tag；不确定时用 main。若你的脚本只认 KERNELSU_TAG，就把这里改成 SukiSU 对应 tag
SUKISU_TAG=main
# 留空则优先从 git 提交数自动算版本；若脚本不支持，编译时手动传 KSU_VERSION=真实值
SUKISU_VERSION=

# 额外配置 Configuration
DISABLE-LTO=false
DISABLE_CC_WERROR=false
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true

########################################################################################################################################################
# 开启 KVM 配置
ENABLE_KVM=false

########################################################################################################################################################

# 开启缓存Ccache
ENABLE_CCACHE=true

# DTBO image
NEED_DTBO=false

# 构建内核直链接Build boot images
BUILD_BOOT_IMG=true
# 请填写 boot.img 的下载地址或本地路径，留空则跳过
SOURCE_BOOT_IMAGE=https://github.com/upxiaoluo-cyber/KernelSU_Action/releases/download/1/boot.img

########################################################################################################################################################
# ===== 华为 DBY-W09 / kona / 4.19 非 GKI 专用补丁开关 =====
# 注意：这些开关本身不会自动生效，需要你的一键脚本按 MD 的改动清单执行 sed/cp/scripts/config。
# 如果脚本不认这些变量，就只在 TXT 里写没用，必须同步改脚本。
HUAWEI_NON_GKI=true
TARGET_BUILD_VARIANT=user
KCFLAGS_EXTRA=-Wno-strict-prototypes
USE_LLVM_IAS=false
DISABLE_RELOCATABLE=true
DISABLE_RANDOMIZE_BASE=true
KEEP_MODVERSIONS=true
FIX_CRLF=true
FIX_AOSP_CC_WRAPPER=true
FIX_KBUILD_INCLUDE=true
FIX_NETFILTER_CASE=true
FIX_AUX_H=true
FIX_KPROBES_DEP=true
FIX_SELINUX_RTICDATA=true
PERMISSIVE_SELINUX=true

########################################################################################################################################################
# ===== 华为 defconfig 特供处理 =====
# 作用文件：arch/arm64/configs/${KERNEL_CONFIG}
# 说明：下面这些开关只是“告诉脚本要做什么”，TXT 本身不会自动改 defconfig。
# 你的一键脚本必须读取这些变量并执行 sed / cp / scripts/config。

# 总开关：是否对华为 defconfig 做防 root / 安全加固 / AVB 处理
HUAWEI_DEFCONFIG_PATCH=true

# 关闭华为安全、防 root、完整性校验相关模块
# 含义：把 defconfig 里存在的 CONFIG_XXX=y 改成 # CONFIG_XXX is not set
# 不存在的不添加，符合“有就改，没有则无需”
HUAWEI_DISABLE_SECURITY_FEATURES=true

# 可选：把 # CONFIG_SECURITY_SELINUX_DEVELOP is not set 改成 CONFIG_SECURITY_SELINUX_DEVELOP=y
# 方便开机默认 Permissive；集成 KernelSU/SukiSU 时，仅建议安卓 9 以上 GSI 使用
HUAWEI_SELINUX_DEVELOP=true

# 关闭 AVB / dm-verity
# CONFIG_DM_VERITY=y        -> # CONFIG_DM_VERITY is not set
# CONFIG_DM_VERITY_AVB=y    -> # CONFIG_DM_VERITY_AVB is not set
HUAWEI_DISABLE_AVB=true

# 是否处理 4.14.x 实验性华为选项
# false：不处理
# true ：处理下面“4.14.x 实验性列表”
# ask  ：编译时交互询问是否处理（需要脚本支持 read）
# 注意：DBY-W09 是 4.19，默认必须 false；只有 4.14.x 内核才考虑
HUAWEI_4_14_EXPERIMENTAL=false

########################################################################################################################################################
# ===== 华为 defconfig 主关闭列表 =====
# 当 HUAWEI_DISABLE_SECURITY_FEATURES=true 时，脚本应对 defconfig 处理这些项：
# HISI_PMALLOC
# HIVIEW_SELINUX
# HISI_SELINUX_EBITMAP_RO
# HISI_SELINUX_PROT
# HISI_RO_LSM_HOOKS
# INTEGRITY
# INTEGRITY_AUDIT
# HUAWEI_CRYPTO_TEST_MDPP
# HUAWEI_SELINUX_DSM
# HUAWEI_HIDESYMS
# HW_SLUB_SANITIZE
# HUAWEI_PROC_CHECK_ROOT
# HW_ROOT_SCAN
# HUAWEI_EIMA
# HUAWEI_EIMA_ACCESS_CONTROL
# HW_DOUBLE_FREE_DYNAMIC_CHECK
# HKIP_ATKINFO
# HW_KERNEL_STP
# HISI_HHEE
# HISI_HHEE_TOKEN
# HISI_DIEID
# HISI_SUBPMU
# TEE_ANTIROOT_CLIENT
# HWAA
#
# 处理规则示例：
# CONFIG_HW_ROOT_SCAN=y
# 改成
# # CONFIG_HW_ROOT_SCAN is not set
#
# 如果 defconfig 里没有这一项，不添加、不报错。

########################################################################################################################################################
# ===== 4.14.x 实验性华为选项列表 =====
# 仅当 HUAWEI_4_14_EXPERIMENTAL=true 或脚本交互询问后用户选择 y 时处理：
# SECURITY_KSHIELD
# HWDPS
# HUAWEI_MDPP_CCMODE
# HUAWEI_SOP
# HKIP_SELINUX_PROT
# HKIP_SELINUX_POLDB_SIZE_MB
# HHEE
# HKIP_MODULE_ALLOC
# UEFI_HHEE
# HKIP_PRMEM
# HKIP_PRMEM_BYPASS
# DEBUG_HKIP_PRMEM
# PRMEM_MAX_MEMORY
# HKIP_PROTECT_BPF
# HKIP_PROTECT_BPF_CAP
# HKIP_PROTECT_POWEROFF_CMD
# HKIP_XOM_CODE
# CFI_CHECK_CACHE_NUM
# HKIP_CFI_HARDEN
# SUBPMU
# HW_ROOT_SCAN_RODATA_MEASUREMENT_API
#
# 带值的也要处理，例如：
# CONFIG_HKIP_SELINUX_POLDB_SIZE_MB=8
# 改成
# # CONFIG_HKIP_SELINUX_POLDB_SIZE_MB is not set

########################################################################################################################################################
# ===== 顺序提醒 =====
# 正确顺序：
# 1. 先改 arch/arm64/configs/${KERNEL_CONFIG}（上面这些 sed）
# 2. make ARCH=arm64 ${KERNEL_CONFIG}
# 3. 再用 scripts/config 关 RELOCATABLE / RANDOMIZE_BASE，开 KPROBES / KRETPROBES / KSU / OVERLAY_FS 等
# 4. make olddefconfig
# 5. 最后 make ... Image
#
# 原因：scripts/config 如果在 make defconfig 之前执行，会被 defconfig 重新覆盖。
########################################################################################################################################################
